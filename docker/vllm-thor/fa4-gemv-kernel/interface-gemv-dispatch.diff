+def _gemv_auto_num_splits(num_kv_heads: int, batch_size: int, device, arch: int) -> int:
+    """FlashInfer Alg.1 split-KV plan for the GEMV decode kernel
+    (flashinfer/attention/scheduler.cuh:176-187): pick ``num_splits`` so the
+    grid ``(num_kv_heads, num_splits, batch)`` fills up to
+    ``max_grid = blocks_per_sm * #SM`` CTAs. The 128-row kv-chunk floor is
+    applied by the caller. ``blocks_per_sm`` is a conservative occupancy
+    estimate for the 96-thread GEMV CTA (~100 regs, ~6 KiB smem -> 4-6
+    resident CTAs/SM; 4 keeps the partial-write traffic small)."""
+    num_SMs = get_num_sms_for_selection(device.index, arch)
+    blocks_per_sm = 4
+    max_grid = num_SMs * blocks_per_sm
+    return max(1, (max_grid + num_kv_heads * batch_size - 1) // (num_kv_heads * batch_size))
+
