+# THOR_SM110_FA4_HD256_FP8_PROBE
+# Process-cached, lazily computed verdict for the FA4 (CuTe-DSL)
+# head_dim=256 full-FP8 attention path on the SM110 family (Jetson
+# Thor). The dedicated hd256 2-CTA kernel is a different compiled
+# unit from the hd<=128 kernel that _thor_fa4_fp8kv_probe above
+# exercises, so its FP8 descale path needs its own one-shot
+# validation before the policy admits an hd256 model to FP8 KV.
+# Same contract as that probe: at most once per process, never at
+# import time, no per-forward overhead, and any failure (no CUDA,
+# CuteDSL missing, JIT failure, OOM, non-finite or divergent output)
+# yields False, keeping the gate closed exactly as stock vLLM does.
+_THOR_FA4_HD256_FP8KV_PROBE_RESULT: bool | None = None
+
+
+def _thor_fa4_hd256_fp8kv_probe() -> bool:
+    """
+    Run one small full-FP8 paged GQA prefill and a decode through the
+    real FA4 head_dim=256 kernel path and compare them against fp32
+    references of the same quantized operands (e4m3 tolerance).
+
+    Returns the cached verdict once computed; ``False`` on any probe
+    failure, which keeps the FP8-KV gate closed for FA4 head_dim=256
+    on this device.
+    """
+    global _THOR_FA4_HD256_FP8KV_PROBE_RESULT
+    if _THOR_FA4_HD256_FP8KV_PROBE_RESULT is not None:
+        return _THOR_FA4_HD256_FP8KV_PROBE_RESULT
+
+    def _finish(enabled: bool, detail: str) -> bool:
+        global _THOR_FA4_HD256_FP8KV_PROBE_RESULT
+        _THOR_FA4_HD256_FP8KV_PROBE_RESULT = enabled
+        if enabled:
+            logger.info("THOR FA4 hd256 FP8-KV probe: enabled on sm_110 (%s)", detail)
+        else:
+            logger.info("THOR FA4 hd256 FP8-KV probe: disabled (%s)", detail)
+        return enabled
+
+    if not current_platform.is_cuda():
+        return _finish(False, "CUDA is not available")
+    if not current_platform.is_device_capability_family(110):
+        return _finish(False, "device is not SM11x")
+
+    try:
+        import torch
+
+        # The production FA4 dispatcher: it imports the CuteDSL
+        # interface (and with it the kernel JIT machinery) lazily
+        # inside the call, so this — the probe's only import — keeps
+        # fa_utils free of import-time side effects.
+        from vllm.vllm_flash_attn import flash_attn_varlen_func
+
+        # The target model's real full-attention geometry (Qwen3.8-27B):
+        # GQA 24 q heads / 4 kv heads, head dim 256, page size 128 (the
+        # hd256 kernel is TMA-paged-only), causal. Two shapes at two
+        # seq lengths: a prefill (q_len == kv_len) and a decode
+        # (q_len == 1). Full FP8: the attention layer quantizes Q to
+        # e4m3 whenever the KV cache is e4m3, so Q, K and V are all
+        # e4m3 here.
+        num_q_heads = 24
+        num_kv_heads = 4
+        head_dim = 256
+        page_size = 128
+        device = "cuda"
+        qhead_per_kvhead = num_q_heads // num_kv_heads
+        cases = [  # (batch, kv_len, q_len)
+            (1, 256, 256),  # prefill: one 128-token page
+            (1, 512, 1),  # decode: two pages
+            # Two sequences: re-verify per-(batch, kv_head) descale indexing
+            # (batch > 0) that the single-sequence cases above cannot cover.
+            (2, 256, 256),
+        ]
+        scale = head_dim ** -0.5
+
+        # Non-trivial, per-(batch, kv_head) descales (all >= 1): the q*k
+        # product stays >= 1 so the softmax is at least as peaked as the
+        # all-ones case, while the per-head-varying magnitudes exercise the
+        # qk_descale and v_descale folds end to end. Each batch row is
+        # distinct from the others (the probe2a-fp8.py ``pat`` pattern), so
+        # a wrong batch index (batch 0 reading batch 1's descales) would
+        # break the A/B.
+        def descales(off: int, batch: int) -> "torch.Tensor":
+            vals = [
+                [
+                    1.0 + 0.0625 * (((b + g + off) % num_kv_heads) + 1)
+                    for g in range(num_kv_heads)
+                ]
+                for b in range(batch)
+            ]
+            return torch.tensor(vals, dtype=torch.float32, device=device)
+
+        for batch, kv_len, q_len in cases:
+            torch.manual_seed(12345 + batch * 100003 + kv_len)
+            num_pages = kv_len // page_size
+            num_pages_total = batch * num_pages
+            # Q is flat over all sequences; K/V live in one paged pool with
+            # contiguous page ranges per sequence (the hd256 kernel is
+            # TMA-paged-only, and all sequences share kv_len so
+            # max_seqlen_k == kv_len satisfies its paged asserts).
+            q = torch.randn(
+                batch * q_len, num_q_heads, head_dim, device=device
+            ).to(torch.float8_e4m3fn)
+            k = torch.randn(
+                num_pages_total, page_size, num_kv_heads, head_dim, device=device
+            ).to(torch.float8_e4m3fn)
+            v = torch.randn(
+                num_pages_total, page_size, num_kv_heads, head_dim, device=device
+            ).to(torch.float8_e4m3fn)
+            q_descale = descales(0, batch)
+            k_descale = descales(2, batch)
+            v_descale = descales(1, batch)
+            k_pool = k.view(num_pages_total, page_size, num_kv_heads, head_dim)
+            v_pool = v.view(num_pages_total, page_size, num_kv_heads, head_dim)
+            cu_seqlens_q = torch.tensor(
+                [q_len * (b + 1) for b in range(-1, batch)],
+                device=device,
+                dtype=torch.int32,
+            )
+            seqused_k = torch.full((batch,), kv_len, dtype=torch.int32, device=device)
+            block_table = torch.arange(
+                num_pages_total, device=device, dtype=torch.int32
+            ).view(batch, num_pages)
+
+            out = flash_attn_varlen_func(
+                q=q,
+                k=k_pool,
+                v=v_pool,
+                max_seqlen_q=q_len,
+                cu_seqlens_q=cu_seqlens_q,
+                max_seqlen_k=kv_len,
+                seqused_k=seqused_k,
+                block_table=block_table,
+                softmax_scale=scale,
+                causal=True,
+                q_descale=q_descale,
+                k_descale=k_descale,
+                v_descale=v_descale,
+                fa_version=4,
+            )
+            torch.cuda.synchronize()
+            out = out[0] if isinstance(out, tuple) else out
+
+            # fp32 reference: per sequence, dequant (per-(batch, kv_head)
+            # descales) + standard bottom-right-aligned causal GQA attention
+            # over the same e4m3 values the kernel reads. The 2**max_offset
+            # factor carried by the kernel's P matrix cancels between O_acc
+            # and row_sum, so no offset correction is needed here.
+            qf = q.float()
+            ref_parts: list[torch.Tensor] = []
+            for b in range(batch):
+                qb = qf[b * q_len : (b + 1) * q_len]
+                kb = k_pool[b * num_pages : (b + 1) * num_pages].view(
+                    kv_len, num_kv_heads, head_dim
+                ).float()
+                vb = v_pool[b * num_pages : (b + 1) * num_pages].view(
+                    kv_len, num_kv_heads, head_dim
+                ).float()
+                q_deq = (
+                    qb
+                    * q_descale[b]
+                    .repeat_interleave(qhead_per_kvhead)
+                    .view(1, num_q_heads, 1)
+                )
+                k_deq = kb * k_descale[b].view(1, num_kv_heads, 1)
+                v_deq = vb * v_descale[b].view(1, num_kv_heads, 1)
+                s = torch.einsum(
+                    "qgad,kgd->qgak",
+                    q_deq.view(q_len, num_kv_heads, qhead_per_kvhead, head_dim),
+                    k_deq,
+                ) * scale
+                q_idx = torch.arange(q_len, device=device)
+                k_idx = torch.arange(kv_len, device=device)
+                keep = k_idx[None, :] <= (q_idx[:, None] + (kv_len - q_len))
+                p = torch.softmax(
+                    s.masked_fill(~keep.view(q_len, 1, 1, kv_len), float("-inf")),
+                    dim=-1,
+                )
+                o = torch.einsum("qgak,kgd->qgad", p, v_deq)
+                ref_parts.append(o.reshape(q_len, num_q_heads, head_dim))
+            ref = torch.cat(ref_parts, dim=0)
+
+            out_f = out.float()
+            max_err = (out_f - ref).abs().max().item()
+            ref_max = ref.abs().max().item()
+            if not (
+                bool(torch.isfinite(out_f).all())
+                and ref_max > 0.0
+                and max_err <= 2e-2 * ref_max + 1e-2
+            ):
+                return _finish(
+                    False,
+                    f"output diverged from reference "
+                    f"(batch={batch}, kv={kv_len}, q={q_len}, "
+                    f"max_err={max_err:.4g}, ref_max={ref_max:.4g})",
+                )
+        return _finish(True, "prefill + decode + multi-seq within e4m3 tolerance")
+    except Exception as exc:  # noqa: BLE001 - any failure keeps the gate closed
+        return _finish(False, f"probe failed: {type(exc).__name__}: {exc}")
+
