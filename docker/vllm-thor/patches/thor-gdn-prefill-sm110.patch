+def _thor_gdn_prefill_probe_run() -> bool:
+    """Compare the FlashInfer GDN prefill kernel against the Triton/FLA
+    reference on a small deterministic input.
+
+    Returns True when both implementations agree within tight bf16
+    tolerances.  Called at most once per process via
+    ``_thor_gdn_prefill_probe`` (only on SM 110, whose arch family is not
+    in FlashInfer's GDN prefill allowlist).
+    """
+    import torch.nn.functional as F
+
+    device = torch.device("cuda")
+    T = 2 * FLA_CHUNK_SIZE
+    H = 2
+    K = 128
+    V = 128
+    dtype = torch.bfloat16
+
+    gen = torch.Generator(device=device).manual_seed(0)
+
+    def randn(*shape: int) -> torch.Tensor:
+        return torch.randn(*shape, generator=gen, device=device)
+
+    # q/k are pre-L2-normalized to mirror the production prefill path,
+    # where fused_post_conv_prep applies L2 norm and the kernels are
+    # called with use_qk_l2norm_in_kernel=False.
+    q = F.normalize(randn(1, T, H, K), p=2, dim=-1).to(dtype)
+    k = F.normalize(randn(1, T, H, K), p=2, dim=-1).to(dtype)
+    v = randn(1, T, H, V).to(dtype)
+    g = F.logsigmoid(randn(1, T, H)).to(dtype)
+    beta = torch.sigmoid(randn(1, T, H)).to(dtype)
+    # Non-zero initial state so the probe also validates state carry-over.
+    initial_state = randn(1, H, V, K) * 0.01
+    cu_seqlens = torch.tensor([0, T], dtype=torch.int32, device=device)
+
+    o_fi, state_fi = fi_chunk_gated_delta_rule(
+        q=q,
+        k=k,
+        v=v,
+        g=g,
+        beta=beta,
+        initial_state=initial_state,
+        output_final_state=True,
+        cu_seqlens=cu_seqlens,
+        use_qk_l2norm_in_kernel=False,
+    )
+    o_ref, state_ref = fla_chunk_gated_delta_rule(
+        q=q,
+        k=k,
+        v=v,
+        g=g,
+        beta=beta,
+        initial_state=initial_state,
+        output_final_state=True,
+        cu_seqlens=cu_seqlens,
+        use_qk_l2norm_in_kernel=False,
+    )
+
+    out_match = torch.allclose(o_fi.float(), o_ref.float(), rtol=2e-2, atol=1e-3)
+    state_match = torch.allclose(
+        state_fi.float(), state_ref.float(), rtol=2e-2, atol=1e-2
+    )
+    return bool(out_match and state_match)
+
+
+def _thor_gdn_prefill_probe() -> bool:
+    """One-shot, process-cached runtime probe for the FlashInfer GDN
+    prefill kernel on Thor (SM 110).
+
+    Runs at most once; the verdict is cached in
+    ``_THOR_GDN_PREFILL_PROBE_VERDICT`` so later calls are a plain
+    bool read with no per-forward overhead.  A missing CUDA device, any
+    exception (e.g. missing FlashInfer, JIT/kernel failure) or an output
+    mismatch resolves to False, keeping the Triton prefill path.
+    """
+    global _THOR_GDN_PREFILL_PROBE_VERDICT
+    if _THOR_GDN_PREFILL_PROBE_VERDICT is not None:
+        return _THOR_GDN_PREFILL_PROBE_VERDICT
+
+    verdict = False
+    try:
+        if torch.cuda.is_available():
+            verdict = _thor_gdn_prefill_probe_run()
+    except Exception:
+        logger.warning(
+            "THOR GDN prefill probe raised; using the Triton GDN prefill kernel.",
+            exc_info=True,
+        )
+
+    _THOR_GDN_PREFILL_PROBE_VERDICT = verdict
+    if verdict:
+        logger.info("THOR GDN prefill probe: FI kernel enabled on sm_110")
+    else:
+        logger.info("THOR GDN prefill probe failed -> Triton fallback")
+    return verdict
+
 
