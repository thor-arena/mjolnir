+# One-shot verdict cache for the Thor (SM 110) GDN prefill probe.
+# None = not probed yet; True = FlashInfer GDN prefill verified on this
+# device; False = keep the Triton prefill path.
+_THOR_GDN_PREFILL_PROBE_VERDICT: bool | None = None
+
