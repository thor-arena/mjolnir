+    def _get_noncausal_prefill_wrapper_cudagraph(
+        self, batch_size: int
+    ) -> BatchPrefillWithPagedKVCacheWrapper:
+        """A per-batch-size, cuda-graph-mode non-causal prefill wrapper for the
+        multi-token draft (DSpark/DSpark draft).
+
+        In cuda-graph mode the FlashInfer prefill wrapper freezes its batch
+        size at creation and reads its KV plan from *persistent* buffers, so a
+        captured run() replays against stable addresses. The draft plans
+        eagerly (outside the captured graph, each step) and only the attention
+        run is captured, so the wrapper must hold persistent buffers. One
+        wrapper is needed per captured batch size, mirroring
+        _decode_wrappers_cudagraph. This is what makes the non-causal draft
+        capture-safe (see get_cudagraph_support's non-causal UNIFORM_BATCH
+        grant and kernel_test_dspark_draft_nonncausal.py).
+        """
+        wrapper = self._noncausal_prefill_wrappers_cudagraph.get(batch_size)
+        if wrapper is None:
+            wrapper = BatchPrefillWithPagedKVCacheWrapper(
+                self._get_workspace_buffer(),
+                get_flashinfer_layout_string(self.kv_cache_layout),
+                use_cuda_graph=True,
+                qo_indptr_buf=self._nc_prefill_qo_indptr_buf[: batch_size + 1],
+                paged_kv_indptr_buf=self.paged_kv_indptr.gpu[: batch_size + 1],
+                paged_kv_indices_buf=self.paged_kv_indices,
+                paged_kv_last_page_len_buf=self.paged_kv_last_page_len.gpu[
+                    :batch_size
+                ],
+                backend="auto",
+            )
+            self._noncausal_prefill_wrappers_cudagraph[batch_size] = wrapper
+        return wrapper
 
