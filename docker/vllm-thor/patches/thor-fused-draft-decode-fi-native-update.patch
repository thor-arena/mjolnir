+    def update_draft_decode_metadata(self, metadata: FlashInferMetadata) -> None:
+        # The trtllm-gen / XQA decode path reads its block table and seq lens
+        # from the live persistent GPU buffers (advanced in place between
+        # draft steps by the slot machinery), so it needs no update. Only the
+        # FI native decode plan (paged_kv_indptr / indices / last_page_len)
+        # must be re-derived in place here.
+        if not isinstance(metadata.decode, FIDecode):
+            return
+        # The fused draft-decode loop only advances a pure, uniform
+        # single-token decode; anything else must not silently reuse a stale
+        # plan.
+        if (
+            metadata.num_prefills != 0
+            or metadata.num_decodes == 0
+            or metadata.num_decode_tokens != metadata.num_decodes
+        ):
+            logger.warning_once(
+                "Fused draft decode is expected to be a uniform single-token "
+                "decode; the FlashInfer decode plan will not be advanced in "
+                "place for this step."
+            )
+            return
+        if self._draft_seq_lens_gpu is None or self._draft_block_table is None:
+            return
