+@triton.jit
+def _advance_fi_decode_plan_kernel(
+    seq_lens,  # [num_reqs] int32, live (already advanced to this draft step)
+    block_table,  # [num_reqs, max_blocks] int32, live
+    block_table_stride,
+    indptr,  # [num_reqs + 1] int32, out (cumulative block counts)
+    last_page_len,  # [num_reqs] int32, out (tokens in each req's last page)
+    page_indices,  # [max_pages] int32, out (block ids in plan order)
+    page_size: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    # One program per request. Re-derives the FlashInfer native decode plan
+    # (paged_kv_indptr / last_page_len / page_indices) for a single decode
+    # step from the request's KV length (seq_lens[req]) and its live block
+    # table. This is the same computation build() does in
+    # _compute_flashinfer_kv_metadata, but on the GPU from the advancing
+    # seq_lens so the fused draft-decode loop can advance the plan between
+    # steps without a host sync or a full rebuild.
+    req_idx = tl.program_id(0)
+    seq_len = tl.load(seq_lens + req_idx)
+    # Two independent quantities, exactly as build()'s
+    # _compute_flashinfer_kv_metadata computes them:
+    #   num_blocks  = ceil(seq_len / page_size)   (0 for an empty request)
+    #   last_page_len = seq_len % page_size, promoted to page_size when a
+    #                   non-empty request lands exactly on a page boundary.
+    if seq_len == 0:
+        num_blocks = 0
+        last_len = 0
+    else:
+        num_blocks = (seq_len + page_size - 1) // page_size
+        last_len = seq_len % page_size
+        if last_len == 0:
+            last_len = page_size
+
+    # The base of this request's page range is the total block count of all
+    # earlier requests. Re-derive it from the read-only seq_lens (not from
+    # indptr, which this same launch is concurrently overwriting) so each
+    # program is independent of the others. num_reqs is small, so the
+    # prefix sum is cheap; it runs on every draft step but is O(num_reqs).
+    base = 0
+    for i in range(0, req_idx):
+        other_len = tl.load(seq_lens + i)
+        other_full = other_len // page_size
+        other_last = other_len - other_full * page_size
+        other_blocks = other_full + (other_last > 0)
+        if other_len == 0:
+            other_blocks = 0
+        base += other_blocks
+
+    tl.store(indptr + req_idx + 1, base + num_blocks)
+    tl.store(last_page_len + req_idx, last_len)
+
+    row_ptr = block_table + req_idx * block_table_stride
+    for i in tl.range(0, num_blocks, BLOCK_SIZE):
+        offset = i + tl.arange(0, BLOCK_SIZE)
+        block_ids = tl.load(row_ptr + offset, mask=offset < num_blocks)
+        tl.store(page_indices + base + offset, block_ids, mask=offset < num_blocks)
