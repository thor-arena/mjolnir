# Example env file for the `mjolnir litellm` CLI.
#
# Copy to ~/.local/share/mjolnir/litellm.env ($MJOLNIR_LITELLM_ENV to
# override) and uncomment/adjust as needed. Every variable is OPTIONAL —
# defaults are baked into docker/litellm/docker-compose.yaml.
#
# Two kinds of variables:
#   1. LITELLM_*/POSTGRES/REDIS — consumed by docker-compose.yaml
#      interpolation (proxy port, keys, credentials, image tag).
#   2. Template variables (${VAR}) — consumed when rendering your
#      ~/litellm_config.template.yaml. The MAIN_LLM_MODEL trio is injected
#      by mjolnir from the active model/config — do not set those here.

# --- LiteLLM proxy ---------------------------------------------------------
# LITELLM_PORT=8000                  # host port for the proxy
# LITELLM_IMAGE_TAG=v1.100.0         # ghcr.io/berriai/litellm:<tag>
# LITELLM_MASTER_KEY=sk-1234         # master key clients send (Authorization)
# LITELLM_UI_USERNAME=admin          # proxy web UI credentials
# LITELLM_UI_PASSWORD=admin
# LITELLM_LOG=INFO

# Where the proxy finds the MAIN vLLM server. Default (injected by mjolnir):
#   http://host.docker.internal:<active mjolnir vLLM port>/v1
# Set it to point the main model at a different vLLM server:
# LITELLM_MAIN_MODEL_BASE_URL=http://192.168.0.138:8000/v1

# --- Postgres (spend logs / UI) -- internal to the stack, not published ----
# LITELLM_POSTGRES_USER=postgres
# LITELLM_POSTGRES_PASSWORD=postgres
# LITELLM_POSTGRES_PORT=5432
# LITELLM_POSTGRES_DB=postgres

# --- Redis (cache + routing) -- internal to the stack, not published ------
# LITELLM_REDIS_HOST=litellm_redis
# LITELLM_REDIS_PORT=6379
# LITELLM_REDIS_PASSWORD=redis

# --- OpenAI-compatible client defaults (litellm container env) -------------
# OPENAI_API_KEY=sk-1
# OPENAI_BASE_URL=http://host.docker.internal:6001/v1

# --- Template variables for the optional task-model sections ---------------
# Only needed if you uncomment those sections in your template.
# TASK_MODELS_BASE_URL=192.168.0.138
# GRAPH_LLM_MODEL=vendor/model
# TASKS_LLM_MODEL=vendor/model
# EMBEDDINGS_MODEL=vendor/model
# RERANKER_MODEL=vendor/model
# STT_MODEL=vendor/model
# TTS_MODEL=vendor/model
# TTS_MODEL_VOICE=default
